# ---------------------------------------------------------------------------
# Command Center backend configuration
# ---------------------------------------------------------------------------
# Drop your OpenAI key here to bring FIELD MARSHAL VOSS online. If left blank
# the agent runs in deterministic OFFLINE mode (fully functional, no network).
OPENAI_API_KEY=

# Optional: override the model the persona speaks through.
OPENAI_MODEL=gpt-4o-mini

# --- Database -------------------------------------------------------------
# Leave BOTH unset for local dev → uses a SQLite file (command_center.db).
# For production, set DATABASE_URL to your Postgres connection string:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/command_center
# (bare postgres:// URLs from managed hosts are auto-normalised)
# DATABASE_URL=
# COMMAND_CENTER_DB=./command_center.db

# --- CORS -----------------------------------------------------------------
# Dev: "*" (allow all). Production: comma-separated allowlist of front-end
# domains, e.g. CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=*
